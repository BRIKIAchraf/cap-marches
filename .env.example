# Copiez ce fichier vers .env. Ne commitez jamais .env.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=zai-org/GLM-5.2

# Adresse de contact affichée dans le User-Agent des appels open data.
APP_CONTACT=

# Hémicycle : clé pour les jeux projets, marchés et Sirene.
HEMICYCLE_API_KEY=
HEMICYCLE_API_URL=https://api.hemicycle.ai/v1/jeux/interroger
HEMICYCLE_API_VERSION=2026-10-01

# Recherche sémantique : tfidf fonctionne sans téléchargement.
SEMANTIC_PROVIDER=tfidf
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Persistance locale. Utilisez PostgreSQL en production multi-instance.
DATABASE_URL=sqlite:///data/cap_marches.db

# Limites de consommation des API et des crédits.
MAX_RESULTS_PER_QUERY=100
MAX_AGENT_RESULTS=20
MAX_SIRENE_ENRICHMENTS=5
